# Copia este archivo a .env y rellena los valores. NUNCA subas el .env a git.

# Contraseña del usuario sa de SQL Server (fuerte: mayúsculas, números, símbolos).
SA_PASSWORD=CambiaEstaClaveFuerte_2026!

# Secreto para firmar los JWT. Mínimo 32 caracteres, aleatorio.
# Genera uno con:  openssl rand -base64 48
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio-de-al-menos-32-chars

# Origen del frontend en Vercel (con https, sin barra final).
FRONTEND_ORIGIN=https://rest.warforgegt.com

# Dominio público del backend (el que apuntará al VPS y sacará el cert HTTPS).
API_DOMAIN=api.warforgegt.com
